[global]
    ### Aparência e tipografia
    font = "JetBrains Mono 10"
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = end
    ignore_newline = no

    ### Posição e tamanho
    origin = top-right
    offset = (6, 38)
    width = 380
    height = (80, 300)
    notification_limit = 5
    progress_bar = true

    ### Espaçamento e bordas
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10
    separator_height = 1
    separator_color = frame
    frame_width = 2
    gap_size = 8
    # corner_radius = 8
    corners = all
    transparency = 0

    ### Ícones
    icon_position = off
    ### min_icon_size = 32
    ### max_icon_size = 48
    ### enable_recursive_icon_lookup = true
    ### icon_theme = "Adwaita"

    ### Comportamento
    follow = none
    sort = true
    indicate_hidden = true
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/rofi -dmenu -p "Dunst"
    browser = /usr/bin/xdg-open

    ### Cores por padrão
    frame_color = "#3794FF"
    highlight = "#3794FF"

[urgency_low]
    background = "#090B10"
    foreground = "#8B949E"
    frame_color = "#313946"
    timeout = 5
    default_icon = dialog-information

[urgency_normal]
    background = "#111319"
    foreground = "#C9CDD5"
    frame_color = "#3794FF"
    timeout = 8
    default_icon = dialog-information

[urgency_critical]
    background = "#1A0D12"
    foreground = "#F2F4F8"
    frame_color = "#F14C4C"
    timeout = 0
    default_icon = dialog-warning
