* {
    font: "JetBrains Mono 10";

    background: #090B10;
    background-alt: #111319;
    foreground: #C9CDD5;
    selected: #203D5B;
    active: #23D18B;
    urgent: #F14C4C;

    border-colour: #252A35;
    separator-colour: #252A35;
    disabled: #555B66;

    text-color: @foreground;
}

window {
    width: 560px;
    border: 1px;
    border-color: @border-colour;
    border-radius: 0px;
    background-color: @background;
    padding: 12px;
}

mainbox {
    background-color: @background;
    children: [inputbar, listview];
    spacing: 8px;
}

inputbar {
    background-color: @background-alt;
    border: 1px;
    border-color: @border-colour;
    border-radius: 0px;
    padding: 8px;
    spacing: 8px;
    children: [prompt, entry];
}

prompt {
    enabled: false;
    str: "";
    text-color: #3794FF;
    background-color: transparent;
}

entry {
    text-color: @foreground;
    background-color: transparent;
    placeholder: "Search...";
    placeholder-color: @disabled;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    fixed-height: true;
    spacing: 0px;
    scrollbar: false;
    border: 0px;
    margin: 0px;
}

element {
    background-color: transparent;
    text-color: @foreground;
    border-radius: 0px;
    padding: 8px;
    spacing: 10px;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color: #FFFFFF;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

message {
    background-color: transparent;
    padding: 8px;
}

textbox {
    background-color: transparent;
    text-color: @disabled;
}
